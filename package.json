{
  "name": "digital-invoice-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "server": "node --env-file-if-exists=.env --watch server/index.js",
    "client": "vite client --host 127.0.0.1",
    "build": "vite build client",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "setup:atlas": "node scripts/setup-atlas.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "mongodb-memory-server": "^10.2.0",
    "prettier": "^3.9.10",
    "vite": "^7.1.0"
  }
}
